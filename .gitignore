# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Run state: a session file is a credential, a manifest is run data.
# Neither belongs in git.
state/
run/
*.session.json
*.jsonl
*.corrupt-*
*.part
exceptions.json

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
